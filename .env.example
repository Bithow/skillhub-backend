# ============================================================
# SkillHub Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in every REQUIRED value
# before starting the server. Never commit .env to git.
# ============================================================


# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------

# Port the Express server listens on (default: 5000)
PORT=5000

# Set to "production" on a live server, "development" locally
NODE_ENV=development


# ------------------------------------------------------------
# DATABASE  [REQUIRED]
# ------------------------------------------------------------

# PostgreSQL connection string — must include the schema
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skillhub?schema=public"

# Only needed when running the Mongo-to-PostgreSQL migration script
# (npm run migrate:mongodb). Leave blank in production.
MONGODB_URI=""


# ------------------------------------------------------------
# AUTHENTICATION  [REQUIRED]
# ------------------------------------------------------------

# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET is REQUIRED. The server will refuse to start without it.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Token expiry for access tokens (default: 7d)
JWT_EXPIRES_IN="7d"


# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------

# Full URL of the deployed frontend — used in notification links and CORS
# Example: https://skillhub-platform.netlify.app
FRONTEND_URL=""


# ------------------------------------------------------------
# PAYMENTS
# ------------------------------------------------------------

# Controls the payment flow:
#   prelaunch_simulated  — no real money; checkouts are simulated (safe for testing)
#   manual_receipt       — users upload a receipt image; admin approves manually
# Leave as prelaunch_simulated until you are ready to accept real payments.
PAYMENT_MODE="prelaunch_simulated"


# ------------------------------------------------------------
# WHATSAPP  (required for notifications and the WhatsApp bot)
# ------------------------------------------------------------

# Admin WhatsApp number in international format e.g. +251912345678
ADMIN_WHATSAPP=""

# WhatsApp Cloud API — from your Meta developer app
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""


# ------------------------------------------------------------
# EMAIL  (required for password reset by email)
# ------------------------------------------------------------

EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""


# ------------------------------------------------------------
# AI STUDIO  (optional — course generation feature)
# ------------------------------------------------------------

# Any OpenAI-compatible API key (OpenAI, Together, Groq, etc.)
AI_STUDIO_API_KEY=""

# Base URL of the provider's API (default: https://api.openai.com/v1)
AI_STUDIO_BASE_URL="https://api.openai.com/v1"

# A label for the provider — only used in logs and admin UI
AI_STUDIO_PROVIDER="openai-compatible"

# Model name to use for course generation
AI_STUDIO_MODEL="gpt-4o-mini"

# Optional monthly spend cap in USD — leave blank to disable the guard
AI_STUDIO_MONTHLY_BUDGET_USD=""

# Token pricing for cost tracking — required when MONTHLY_BUDGET_USD is set
# Example values for gpt-4o-mini: input=0.15, output=0.60 (per million tokens)
AI_STUDIO_INPUT_COST_PER_MILLION=""
AI_STUDIO_OUTPUT_COST_PER_MILLION=""

# Future features — leave blank until implemented
AI_STUDIO_VIDEO_API_KEY=""
AI_STUDIO_VOICE_API_KEY=""
AI_STUDIO_STORAGE_BUCKET=""


# ------------------------------------------------------------
# DATABASE SEEDING  (npm run seed — run once to create admin)
# ------------------------------------------------------------

# Email and password for the initial admin account.
# Must be set before running: npm run seed
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


# ------------------------------------------------------------
# TESTING  (npm test)
# ------------------------------------------------------------

# A separate PostgreSQL database for integration tests.
# The URL must contain the word "test" as a safety guard.
# Example: postgresql://USER:PASSWORD@HOST:5432/skillhub_test?schema=public
TEST_DATABASE_URL=""
